    {
      "parameters": {
        "jsCode": "\nfunction extractDDD(sender) {\n  const digits = String(sender || \"\").replace(/\\D/g, \"\");\n  if (digits.startsWith(\"55\") && digits.length >= 4) return digits.slice(2, 4);\n  if (digits.length >= 2) return digits.slice(0, 2);\n  return null;\n}\n\nfunction dddToUF(ddd) {\n  const map = {\n    \"11\":\"SP\",\"12\":\"SP\",\"13\":\"SP\",\"14\":\"SP\",\"15\":\"SP\",\"16\":\"SP\",\"17\":\"SP\",\"18\":\"SP\",\"19\":\"SP\",\n    \"21\":\"RJ\",\"22\":\"RJ\",\"24\":\"RJ\",\"27\":\"ES\",\"28\":\"ES\",\n    \"31\":\"MG\",\"32\":\"MG\",\"33\":\"MG\",\"34\":\"MG\",\"35\":\"MG\",\"37\":\"MG\",\"38\":\"MG\",\n    \"41\":\"PR\",\"42\":\"PR\",\"43\":\"PR\",\"44\":\"PR\",\"45\":\"PR\",\"46\":\"PR\",\n    \"47\":\"SC\",\"48\":\"SC\",\"49\":\"SC\",\n    \"51\":\"RS\",\"53\":\"RS\",\"54\":\"RS\",\"55\":\"RS\",\n    \"61\":\"DF\",\"62\":\"GO\",\"64\":\"GO\",\"67\":\"MS\",\"65\":\"MT\",\"66\":\"MT\",\n    \"68\":\"AC\",\"69\":\"RO\",\"71\":\"BA\",\"73\":\"BA\",\"74\":\"BA\",\"75\":\"BA\",\"77\":\"BA\",\n    \"79\":\"SE\",\"81\":\"PE\",\"87\":\"PE\",\"82\":\"AL\",\"83\":\"PB\",\"84\":\"RN\",\n    \"85\":\"CE\",\"88\":\"CE\",\"86\":\"PI\",\"89\":\"PI\",\"91\":\"PA\",\"93\":\"PA\",\"94\":\"PA\",\n    \"92\":\"AM\",\"97\":\"AM\",\"95\":\"RR\",\"96\":\"AP\",\"98\":\"MA\",\"99\":\"MA\",\"63\":\"TO\"\n  };\n  return map[String(ddd)] || null;\n}\n\nconst rawMessage = $item(\"0\").$node[\"mensagemFinal\"].json[\"mensagem\"] || \"\";\nconst body = $item(\"0\").$node[\"Webhook\"].json[\"body\"] || {};\n\nlet sender = body.participantPhone || null;\nif (sender && !sender.includes('@')) sender = sender + '@s.whatsapp.net';\n\nlet groupJid = body.phone || \"\";\nif (!groupJid.includes('@')) groupJid = groupJid + '@g.us';\n\nconst ddd = extractDDD(body.participantPhone);\n\nreturn {\n  json: {\n    message_id: body.messageId,\n    instance_name: body.instanceId,\n    group_jid: groupJid,\n    sender_jid: sender,\n    sender_name: body.senderName || \"Desconhecido\",\n    message_type: body.text ? 'text' : (body.image ? 'image' : (body.audio ? 'audio' : (body.video ? 'video' : 'unknown'))),\n    content_text: rawMessage,\n    raw_payload: body,\n    message_date: new Date(body.momment || Date.now()).toISOString().slice(0,10),\n    message_timestamp: new Date(body.momment || Date.now()).toISOString(),\n    processed: false,\n    ddd: ddd,\n    estado: dddToUF(ddd),\n    group_name: body.chatName || \"Grupo Desconhecido\"\n  }\n};\n"
      },

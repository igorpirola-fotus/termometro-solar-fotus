# ── ANTHROPIC ────────────────────────────────────────────────────────────────
# Chave da API Anthropic (Claude Sonnet)
# Configurar em: Supabase Dashboard → Edge Functions → Secrets
ANTHROPIC_API_KEY=sk-ant-...

# ── SUPABASE ─────────────────────────────────────────────────────────────────
# URL do projeto Supabase (visível no Dashboard → Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Chave anon/pública — usada no frontend e nos workflows n8n para leitura
# NÃO é secreta, pode aparecer no código frontend
SUPABASE_ANON_KEY=sb_publishable_...

# Chave service_role — usada APENAS nas Edge Functions (backend) e no header Authorization dos workflows n8n
# NUNCA expor no frontend ou em repositório público
# ⚠️ IMPORTANTE: usar o formato JWT (começa com eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
# NÃO usar o formato novo sb_secret_... — Edge Functions do Supabase rejeitam com "Invalid JWT"
# Onde encontrar: Supabase Dashboard → Project Settings → API → service_role (clicar em "Reveal")
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── RESEND (EMAIL) ────────────────────────────────────────────────────────────
# Chave da API Resend para envio de newsletters
# Configurar em: n8n → Credentials → Header Auth (nome: Resend API)
# ⏳ PENDÊNCIA TI: verificar domínio fotus.com.br no Resend para enviar de termometro@fotus.com.br
RESEND_API_KEY=re_...

# ── SCRAPECREATORS (INSTAGRAM) ────────────────────────────────────────────────
# Chave da API ScrapeCreators para coleta de dados Instagram
# Configurar em: n8n → Credentials → Header Auth (nome: ScrapeCreators)
SCRAPECREATORS_API_KEY=...

# ── VERCEL (API INTERNA) ──────────────────────────────────────────────────────
# Token de autenticação para o endpoint /api/analyze-pdf
# Gerar com: openssl rand -hex 32
# Configurar em: Vercel Dashboard → Project → Settings → Environment Variables
# ⏳ PENDÊNCIA TI: também configurar CORS restrito após setup de domínio fotus.com.br
INTERNAL_API_TOKEN=...

# ── N8N ───────────────────────────────────────────────────────────────────────
# Instância: https://fotus-n8n-editor.mk863j.easypanel.host
# API Key configurada diretamente no painel n8n (válida até 17/08/2026)
# N8N_API_KEY=...

# ── POSTGRES INTERNO (EasyPanel) ─────────────────────────────────────────────
# Banco onde chegam as mensagens Z-API do WhatsApp
# Credencial configurada no n8n como "Postgres account"
# POSTGRES_HOST=...
# POSTGRES_DB=...
# POSTGRES_USER=...
# POSTGRES_PASSWORD=...

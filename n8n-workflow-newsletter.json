{
  "name": "#02 TMS · 02 · ENTREGA · Newsletter & Briefing",
  "nodes": [
    {
      "id": "node-schedule",
      "name": "Disparo 07:50 BRT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "50 10 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "node-http-relatorio",
      "name": "Busca Relatório de Hoje",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "parameters": {
        "method": "GET",
        "url": "https://wttmlnhzvevtabjetsqz.supabase.co/rest/v1/relatorios",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "SUPABASE_SERVICE_ROLE_JWT" },
            { "name": "Authorization", "value": "Bearer SUPABASE_SERVICE_ROLE_JWT" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "id,data_referencia,payload" },
            { "name": "data_referencia", "value": "=eq.{{ $now.minus({days: 1}).toFormat('yyyy-MM-dd') }}" },
            { "name": "order", "value": "created_at.desc" },
            { "name": "limit", "value": "1" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-code-extrai",
      "name": "Extrai Relatório",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.all();\n// HTTP node pode retornar o array como um item ou items separados\nlet relatorio = null;\nif (raw.length === 1 && Array.isArray(raw[0].json)) {\n  relatorio = raw[0].json[0] || null;\n} else if (raw.length >= 1 && raw[0].json?.id) {\n  relatorio = raw[0].json;\n}\nreturn [{ json: { relatorio, found: !!(relatorio?.id) } }];"
      }
    },
    {
      "id": "node-if-relatorio",
      "name": "Relatório Existe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "check-exists",
              "leftValue": "={{ $json.found }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-code-newsletter-body",
      "name": "Prepara Body Newsletter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 180],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const relatorio = $('Extrai Relatório').first().json.relatorio;\nconst inscritos = ['igor.pirola@fotus.com.br'];\n\nreturn [{\n  json: {\n    payload: relatorio.payload,\n    tipo: 'newsletter',\n    inscritos,\n    total_inscritos: inscritos.length\n  }\n}];"
      }
    },
    {
      "id": "node-http-newsletter",
      "name": "Gera HTML Newsletter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 180],
      "parameters": {
        "method": "POST",
        "url": "https://wttmlnhzvevtabjetsqz.supabase.co/functions/v1/generate-newsletter",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Authorization", "value": "Bearer SUPABASE_SERVICE_ROLE_JWT" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ payload: $json.payload, tipo: $json.tipo }) }}"
      }
    },
    {
      "id": "node-code-briefing-body",
      "name": "Prepara Body Briefing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 420],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const relatorio = $('Extrai Relatório').first().json.relatorio;\n\nconst briefingDestinatarios = ['igor.pirola@fotus.com.br'];\n\nreturn [{\n  json: {\n    payload: relatorio.payload,\n    tipo: 'briefing',\n    destinatarios: briefingDestinatarios\n  }\n}];"
      }
    },
    {
      "id": "node-http-briefing",
      "name": "Gera HTML Briefing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 420],
      "parameters": {
        "method": "POST",
        "url": "https://wttmlnhzvevtabjetsqz.supabase.co/functions/v1/generate-newsletter",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Authorization", "value": "Bearer SUPABASE_SERVICE_ROLE_JWT" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ payload: $json.payload, tipo: $json.tipo }) }}"
      }
    },
    {
      "id": "node-code-send-newsletter",
      "name": "Monta Envio Newsletter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1680, 180],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const htmlResp = $('Gera HTML Newsletter').first().json;\nconst bodyPrep = $('Prepara Body Newsletter').first().json;\n\nconst dataRef = (htmlResp.data_referencia ?? new Date().toISOString()).slice(0, 10);\nconst d = new Date(dataRef + 'T12:00:00Z');\nconst dataFmt = d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });\n\nconst kpis = htmlResp.payload?.kpis ?? {};\nconst score = kpis.score_aquecimento ?? 0;\nconst scoreLabel = score > 80 ? 'Aquecido' : score > 60 ? 'Parcialmente Quente' : score > 40 ? 'Morno' : score > 20 ? 'Parcialmente Frio' : 'Frio';\n\nreturn bodyPrep.inscritos.map(email => ({\n  json: {\n    to: email,\n    subject: `Termometro Solar - ${score} ${scoreLabel} - ${dataFmt}`,\n    html: htmlResp.html\n  }\n}));"
      }
    },
    {
      "id": "node-email-newsletter",
      "name": "Envia Newsletter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1920, 180],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ from: 'Termômetro Solar <onboarding@resend.dev>', to: [$json.to], subject: $json.subject, html: $json.html }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "name": "Resend API" }
      }
    },
    {
      "id": "node-code-send-briefing",
      "name": "Monta Envio Briefing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1680, 420],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const htmlResp = $('Gera HTML Briefing').first().json;\nconst bodyPrep = $('Prepara Body Briefing').first().json;\n\nconst dataRef = (htmlResp.data_referencia ?? new Date().toISOString()).slice(0, 10);\nconst d = new Date(dataRef + 'T12:00:00Z');\nconst dataFmt = d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });\n\nconst kpis = htmlResp.payload?.kpis ?? {};\nconst score = kpis.score_aquecimento ?? 0;\nconst scoreLabel = score > 80 ? 'Aquecido' : score > 60 ? 'Parcialmente Quente' : score > 40 ? 'Morno' : score > 20 ? 'Parcialmente Frio' : 'Frio';\n\nreturn bodyPrep.destinatarios.map(email => ({\n  json: {\n    to: email,\n    subject: `Fotus Mercado | ${score}° ${scoreLabel} | ${dataFmt}`,\n    html: htmlResp.html\n  }\n}));"
      }
    },

{
  "name": "Termômetro – Newsletter & Briefing Diário",
  "nodes": [
    {
      "id": "node-schedule",
      "name": "Disparo 07:50 BRT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "50 10 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "node-pg-relatorio",
      "name": "Busca Relatório de Hoje",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [480, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, data_referencia, payload FROM public.relatorios WHERE data_referencia = CURRENT_DATE ORDER BY created_at DESC LIMIT 1",
        "options": {}
      },
      "credentials": {
        "postgres": { "name": "Postgres account" }
      }
    },
    {
      "id": "node-if-relatorio",
      "name": "Relatório Existe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "check-exists",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-pg-inscritos",
      "name": "Busca Inscritos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [960, 200],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT email FROM public.newsletter_subscribers WHERE ativo = true AND email LIKE '%@fotus.com.br'",
        "options": {}
      },
      "credentials": {
        "postgres": { "name": "Postgres account" }
      }
    },
    {
      "id": "node-code-newsletter-body",
      "name": "Prepara Body Newsletter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 200],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const relatorio = $('Busca Relatório de Hoje').first().json;\nconst inscritos = $('Busca Inscritos').all().map(i => i.json.email);\n\nreturn [{\n  json: {\n    payload: relatorio.payload,\n    tipo: 'newsletter',\n    inscritos,\n    total_inscritos: inscritos.length\n  }\n}];"
      }
    },
    {
      "id": "node-http-newsletter",
      "name": "Gera HTML Newsletter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 200],
      "parameters": {
        "method": "POST",
        "url": "https://wttmlnhzvevtabjetsqz.supabase.co/functions/v1/generate-newsletter",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Authorization", "value": "Bearer {{$env.SUPABASE_SERVICE_KEY}}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ payload: $json.payload, tipo: $json.tipo }) }}"
      }
    },
    {
      "id": "node-code-briefing-body",
      "name": "Prepara Body Briefing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 420],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const relatorio = $('Busca Relatório de Hoje').first().json;\n\n// Destinatários hard-coded do briefing executivo\nconst briefingDestinatarios = [\n  'jose.joao@fotus.com.br',\n  'breno.ventorim@fotus.com.br',\n  'bruna.pilon@fotus.com.br',\n  'igor.pirola@fotus.com.br'\n];\n\nreturn [{\n  json: {\n    payload: relatorio.payload,\n    tipo: 'briefing',\n    destinatarios: briefingDestinatarios\n  }\n}];"
      }
    },
    {
      "id": "node-http-briefing",
      "name": "Gera HTML Briefing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 420],
      "parameters": {
        "method": "POST",
        "url": "https://wttmlnhzvevtabjetsqz.supabase.co/functions/v1/generate-newsletter",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Authorization", "value": "Bearer {{$env.SUPABASE_SERVICE_KEY}}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ payload: $json.payload, tipo: $json.tipo }) }}"
      }
    },
    {
      "id": "node-code-send-newsletter",
      "name": "Monta Envio Newsletter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1680, 200],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const htmlResp = $('Gera HTML Newsletter').first().json;\nconst bodyPrep = $('Prepara Body Newsletter').first().json;\n\nconst dataRef = htmlResp.data_referencia ?? new Date().toISOString().slice(0, 10);\nconst d = new Date(dataRef + 'T12:00:00Z');\nconst dataFmt = d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });\n\nconst kpis = htmlResp.payload?.kpis ?? {};\nconst score = kpis.score_aquecimento ?? 0;\nconst scoreLabel = score >= 70 ? 'AQUECIDO' : score >= 50 ? 'MORNO' : 'ESFRIADO';\n\nreturn bodyPrep.inscritos.map(email => ({\n  json: {\n    to: email,\n    subject: `O Termômetro Solar · ${score}° ${scoreLabel} · ${dataFmt}`,\n    html: htmlResp.html\n  }\n}));"
      }
    },
    {
      "id": "node-email-newsletter",
      "name": "Envia Newsletter",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1920, 200],
      "parameters": {
        "fromEmail": "termometro@fotus.com.br",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "credentials": {
        "smtp": { "name": "SMTP Fotus" }
      }
    },
    {
      "id": "node-code-send-briefing",
      "name": "Monta Envio Briefing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1680, 420],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const htmlResp = $('Gera HTML Briefing').first().json;\nconst bodyPrep = $('Prepara Body Briefing').first().json;\n\nconst dataRef = htmlResp.data_referencia ?? new Date().toISOString().slice(0, 10);\nconst d = new Date(dataRef + 'T12:00:00Z');\nconst dataFmt = d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });\n\nconst kpis = htmlResp.payload?.kpis ?? {};\nconst score = kpis.score_aquecimento ?? 0;\nconst tendencia = htmlResp.payload?.meta?.tendencia ?? '';\nconst scoreLabel = score >= 70 ? 'AQUECIDO' : score >= 50 ? 'MORNO' : 'ESFRIADO';\n\nreturn bodyPrep.destinatarios.map(email => ({\n  json: {\n    to: email,\n    subject: `Fotus Mercado | ${score}° ${scoreLabel} | ${dataFmt}`,\n    html: htmlResp.html\n  }\n}));"
      }
    },
    {
      "id": "node-email-briefing",
      "name": "Envia Briefing Executivo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1920, 420],
      "parameters": {
        "fromEmail": "termometro@fotus.com.br",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "credentials": {
        "smtp": { "name": "SMTP Fotus" }
      }
    },
    {
      "id": "node-stop",
      "name": "Sem Relatório — Para",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [960, 480],
